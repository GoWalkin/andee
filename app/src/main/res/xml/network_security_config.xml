<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext hosts have to be named one by one. Android blocks plain HTTP
         everywhere else, and what it produces ("CLEARTEXT communication to X
         not permitted by network security policy") surfaces as a version row
         reading 查不到: an error message about a policy rather than about
         anything the user did.

         Only one host is listed, and it is not the version service any more.
         That one moved to https://api.heyandee.com, so its cleartext hole was
         deleted rather than left behind: an exception for a host nobody calls
         only widens what the app will talk to in the clear. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">124.71.176.202</domain>
    </domain-config>

    <!-- GoWalkin fork: an LLM router running on this same phone (FreeLLMAPI in
         Termux, http://127.0.0.1:3001/v1) is plain HTTP by nature. Loopback
         never leaves the device, so this hole widens nothing on the network;
         without it every brain request dies as "CLEARTEXT communication to
         127.0.0.1 not permitted". The debug copy already had these two. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
